    <string name="ref_handoff_2_body">"Surface: #FFFFFF\nPrimary Ink: #111827\nSecondary Text: #8E95A2\nQuiet Surface: #F4F5F7\nHairline Border: #E5E7EB\nPrimary CTA: #17191D\nAccent Blue: #2563EB\nSuccess: #047857\nWarning: #B45309\nDestructive: #B42318"</string>
